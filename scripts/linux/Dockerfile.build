# Build environment for the Linux daemon (`jetlined`).
#
#   docker build -t jetline-linux-build -f scripts/linux/Dockerfile.build scripts/linux
#   docker run --rm -v "$PWD":/src -w /src jetline-linux-build \
#       swift build -c release --product jetlined --static-swift-stdlib --scratch-path /tmp/jl-build
FROM swift:6.4-noble
RUN apt-get update \
 && apt-get install -y --no-install-recommends libsqlite3-dev git \
 && rm -rf /var/lib/apt/lists/*
